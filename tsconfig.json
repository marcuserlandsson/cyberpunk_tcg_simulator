{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // The Vite-config module chain (vite.config.ts -> src/server/**) must use
    // explicit .ts extensions, or Vite's `configLoader: 'native'` prints a
    // deprecation banner on every `vite`/`vitest` invocation. Safe here
    // because nothing is emitted: TypeScript only ever resolves these paths.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["src", "tests", "scripts", "e2e", "playwright.config.ts"]
}
